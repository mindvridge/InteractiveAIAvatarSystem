# 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS 설정 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI API 설정 (선택사항)
# OpenAI API를 사용하려면 아래 주석을 해제하고 키를 입력하세요
# OPENAI_API_KEY=your-openai-api-key-here
# USE_OPENAI_LLM=true

# Ollama 설정 (로컬 LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
USE_OPENAI_LLM=false

# AI 모델 설정
WHISPER_MODEL=base
# Whisper 모델 크기: tiny, base, small, medium, large
# tiny: 가장 빠름, 정확도 낮음
# base: 균형잡힌 성능 (권장)
# small: 더 정확하지만 느림
# medium, large: 매우 정확하지만 GPU 권장

# TTS 모델 설정
TTS_MODEL=tts_models/ko/cv/vits
# 한국어 TTS 모델
# 영어 모델을 사용하려면: tts_models/en/ljspeech/tacotron2-DDC

# 오디오 설정
SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# 비디오 설정 (Wav2Lip - Phase 2에서 사용)
VIDEO_FPS=25
VIDEO_RESOLUTION=256,256
AVATAR_IMAGE_PATH=models/avatar.jpg
WAV2LIP_CHECKPOINT=models/wav2lip_gan.pth

# 성능 설정
MAX_AUDIO_CHUNK_SIZE=16384
DEVICE=cpu
# GPU를 사용하려면: DEVICE=cuda

# 모델 경로
MODELS_DIR=models
